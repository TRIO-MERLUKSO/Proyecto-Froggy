
import pygame
import math

MORADO=(142, 68, 173)
VERDE=(22, 163, 133)
GRIS=(200,200, 200)
velocidad=20
################################################
# Inicio de la ejecución
################################################
pygame.init()
screen=pygame.display.set_mode([750, 750])
pygame.display.set_caption("Croosy road")
game_over=False


jugador = pygame.Rect(20, 20, 30, 30)
camion = pygame.Rect(0,200,20,20)
while not game_over:    
    for event in pygame.event.get():
        if event.type==pygame.QUIT:               
             game_over=True         
    pygame.time.delay(100)         
    screen.fill(GRIS)
    pygame.draw.rect(screen, MORADO, jugador)
    pygame.draw.rect(screen, VERDE,camion)
    if camion.x>=jugador.x-15 and camion.x<=jugador.x+15 and camion.y==jugador.y:
        print('Has muerto')
        game_over=True
    
    pygame.display.flip()
    
    teclas = pygame.key.get_pressed()
    
    if teclas[pygame.K_w]:
        jugador.y -= velocidad  # mover arriba
    if teclas[pygame.K_s]:
        jugador.y += velocidad  # abajo
    if teclas[pygame.K_a]:
        jugador.x -= velocidad  # izquierda
    if teclas[pygame.K_d]:
        jugador.x += velocidad  # derecha
    if jugador.x<15:
        jugador.x +=velocidad
    if jugador.x>=735:
        jugador.x -=velocidad
    if jugador.y<=15:
        jugador.y+=velocidad
    if jugador.y>=735:
        jugador.y-=velocidad
    camion.x +=5


    # Dibujar el "jugador"

    pygame.display.update()
pygame.quit()    
