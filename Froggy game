    pygame.display.set_caption("Crossy Road")

    seguir = True
    tiempos = []
    muertes = 0
    listmuertes = []
    nivel_1=True
    nivel_2=False
    nivel_3=False
    nivel_4=False
    while seguir:
        op = menu(screen)
        pygame.mixer.quit()
        if op == 0:
            if nivel_1:
                seguir, t, muertes,nivel_2 = juego1(screen, muertes)
                tiempos.append(t)
                listmuertes.append(muertes)
