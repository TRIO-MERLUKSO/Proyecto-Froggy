                nivel_2=False
                seguir, t, muertes,nivel_4 = juego3(screen, muertes)
                tiempos.append(t)
                listmuertes.append(muertes)
            if nivel_4:
                muertes=0
                nivel_1=True
                nivel_2=False
                nivel_3=False
        elif op == 2:
            creds(screen)

        elif op == 3:
            seguir = False

    pygame.quit()

main()



